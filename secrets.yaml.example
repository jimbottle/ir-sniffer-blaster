# Copy this file to `secrets.yaml` (same directory as the device config) and fill
# in real values. `secrets.yaml` is git-ignored and must NEVER be committed.
#
# Referenced from ir-blaster-livingroom.yaml via the `!secret <key>` syntax.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Pre-shared key for the encrypted Home Assistant API connection.
# Generate with:  openssl rand -base64 32
api_encryption_key: "GENERATE_ME_WITH_openssl_rand_-base64_32"

# Password gating OTA (over-the-air) firmware updates after the first USB flash.
# Use any strong passphrase; you'll need it for every network re-flash.
ota_password: "CHOOSE_A_STRONG_OTA_PASSWORD"
